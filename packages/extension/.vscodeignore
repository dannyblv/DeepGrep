# Source / build inputs — not needed at runtime
.git/**
.github/**
src/**
__tests__/**
*.map
**/*.ts
!**/*.d.ts
tsconfig.json
esbuild.mjs
.eslintrc*
.prettierrc*
scripts/run-tests.mjs

# Exclude devDependencies that are not needed at runtime.
# We do NOT use a blanket `node_modules/**` exclusion because vsce does not
# reliably process negation patterns against it (the negation is silently ignored).
# Instead, we explicitly exclude the packages we know are dev-only.
node_modules/@types/**
node_modules/esbuild/**
node_modules/typescript/**
node_modules/mocha/**
node_modules/ts-node/**
node_modules/rimraf/**
node_modules/@vscode/vsce/**

# Exclude noisy files inside node_modules
node_modules/**/test/**
node_modules/**/tests/**
node_modules/**/__tests__/**
node_modules/**/*.map
node_modules/**/*.ts
!node_modules/**/*.d.ts
node_modules/**/CHANGELOG*
node_modules/**/README*
node_modules/**/readme*
