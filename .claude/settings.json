          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/danny.braunstein/Desktop/Danny/DeepGrep/scripts/post-tool-use.mjs"
          }
        ]
      }
    ]
  },
  "permissions": {
