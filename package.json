{
  "name": "deepgrep-root",
  "private": true,
  "version": "1.0.2",
  "scripts": {
    "setup":           "pnpm install && node scripts/rebuild-native.mjs && pnpm build:rust && pnpm build",
    "build":           "pnpm -r build",
    "build:rust":      "cargo build --release",
    "build:rust:debug":"cargo build",
    "dev":             "pnpm -r --parallel dev",
    "test":            "pnpm -r test",
    "package":         "pnpm --filter deepgrep-extension package",
    "clean":           "pnpm -r clean && rimraf node_modules && cargo clean"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild", "keytar", "@vscode/vsce-sign"]
  }
}
