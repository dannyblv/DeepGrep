{
  "name": "deepgrep-root",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "setup": "pnpm install && node scripts/copy-grammars.mjs && node scripts/rebuild-native.mjs && pnpm build",
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "test": "pnpm -r test",
    "package": "pnpm --filter deepgrep-extension package",
    "clean": "pnpm -r clean && rimraf node_modules"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild", "keytar", "@vscode/vsce-sign"]
  }
}
