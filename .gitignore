# ── Dependencies ────────────────────────────────────────────────────────────
node_modules/

# ── Build outputs ────────────────────────────────────────────────────────────
dist/
out/
*.vsix

# Bundled runtime deps written by scripts/resolve-symlinks.mjs — generated, not source
packages/extension/dist/node_modules/

# ── Rust ─────────────────────────────────────────────────────────────────────
target/

# Compiled Rust binaries copied into the extension by scripts/copy-binaries.mjs
packages/extension/bin/

# Native addon build artifacts (rebuilt per Electron version via pnpm rebuild-native)
*.node
build/Release/

# ── TypeScript ───────────────────────────────────────────────────────────────
*.tsbuildinfo

# ── Runtime / generated data ─────────────────────────────────────────────────
.deepgrep/

# ── Tree-sitter grammars (copied from tree-sitter-wasms at build time) ───────
packages/extension/grammars/

# ── MCP local discovery config (written per-workspace by the extension) ──────
.mcp.json

# Claude Code hooks / agent memory written per-workspace by HookManager
.claude/settings.json
.claude/agent-memory/

# ── Source maps ──────────────────────────────────────────────────────────────
*.js.map

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Environment ──────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Editor ───────────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo
