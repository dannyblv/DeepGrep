{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "compile-extension",
      "type": "shell",
      "command": "pnpm compile",
      "options": { "cwd": "${workspaceFolder}/packages/extension" },
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "silent", "panel": "shared" },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "watch-extension",
      "type": "shell",
      "command": "pnpm dev",
      "options": { "cwd": "${workspaceFolder}/packages/extension" },
      "isBackground": true,
      "group": "build",
      "presentation": { "reveal": "silent", "panel": "shared" },
      "problemMatcher": {
        "owner": "esbuild",
        "pattern": { "regexp": "^(.*):(\\d+):(\\d+): (error|warning): (.*)$", "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5 },
        "background": { "activeOnStart": true, "beginsPattern": "\\[watch\\]", "endsPattern": "\\[watch\\] build finished" }
      }
    },
    {
      "label": "build-rust",
      "type": "shell",
      "command": "cargo build --release",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "build-all",
      "dependsOn": ["build-rust", "compile-extension"],
      "dependsOrder": "parallel",
      "group": "build",
      "presentation": { "reveal": "silent" }
    }
  ]
}
